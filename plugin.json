{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "ladder-search",
  "version": "0.1.3",
  "description": "Web search and page-reading ladder for Claude Code and Codex: parallel source search, then TinyFish -> Jina -> camofox -> logged-in Chrome (CDP), escalating only when blocked.",
  "author": {
    "name": "royalskynet",
    "url": "https://github.com/royalskynet"
  },
  "homepage": "https://github.com/royalskynet/ladder-search",
  "repository": "https://github.com/royalskynet/ladder-search",
  "license": "MIT",
  "keywords": [
    "web",
    "search",
    "fetch",
    "jina",
    "exa",
    "cdp",
    "scraping",
    "codex",
    "claude-code"
  ],
  "extensions": {
    "com.openai": {
      "hooks": "./hooks/hooks.json",
      "interface": {
        "displayName": "ladder-search",
        "shortDescription": "Search the web and read blocked pages through an escalation ladder",
        "developerName": "royalskynet",
        "category": "Developer Tools",
        "capabilities": [
          "Read"
        ],
        "websiteURL": "https://github.com/royalskynet/ladder-search"
      }
    }
  }
}
